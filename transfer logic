  for (int i = 0; i < num_bursts ; i ++) begin
            `uvm_info(get_type_name(), $psprintf("----------------------------------------------------------"), UVM_LOW)
            `uvm_info(get_type_name(), $psprintf(" AXI SIMPLE BURST WRITE TRANSACTION COUNT %0d ", i), UVM_LOW)
            `uvm_info(get_type_name(), $psprintf("----------------------------------------------------------"), UVM_LOW)
     
            status = randomize(trans_start_address);        //SHIVANI - TO RANDOMIZE ADDRESS FOR EACH TRANSACTION PAIR

            // Simple Random Burst Write

            `uvm_create_on(masterBurst,p_sequencer.p_axi_if0_m_seqr);
            `uvm_rand_send_with(masterBurst,  { 
               masterBurst.Direction ==  DENALI_CDN_AXI_DIRECTION_WRITE;
               masterBurst.Length <= beats_per_burst;
	           masterBurst.IdTag <= 'hFF; 
	           masterBurst.StartAddress ==  {32'h0,trans_start_address};
		   masterBurst.Kind == DENALI_CDN_AXI_BURSTKIND_INCR;
               masterBurst.Bufferable == 'h1;
               masterBurst.Cacheable == 'h1;
               masterBurst.ReadAllocate == 'h1;
    		   masterBurst.WriteAllocate == 'h1;
    		   masterBurst.Privileged == 'h1;	
    		   masterBurst.Secure == 'h1;
    		   masterBurst.DataInstr == 'h1;
	        })
end
